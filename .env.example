# Токен Discord-бота (Discord Developer Portal → Bot → Reset Token). Обязательная переменная.
DISCORD_TOKEN=

# ID сервера для точечной регистрации команд и настройки структуры.
# Узнать: Настройки Discord → Расширенные → включить «Режим разработчика»,
# затем ПКМ по серверу → «Копировать ID сервера».
GUILD_ID=

# ID «официального» сервера, где проходят МП (необязательно).
# Если задан и бот приглашён туда — каналы мероприятий (текстовый и голосовой)
# создаются на этом сервере, а не на сервере организаторов.
OFFICIAL_GUILD_ID=

# Webhook для анонсов МП на официальном сервере (необязательно).
# Создайте вебхук в канале официального сервера (Настройки канала → Интеграция
# → Вебхуки → Новый вебхук) и вставьте сюда ссылку. Пока не задан — анонсы
# публикуются в тестовый канал сервера организаторов (📣・анонсы-мп).
ANNOUNCE_WEBHOOK_URL=

# База данных: строка подключения Prisma.
# SQLite (рекомендуется для одной копии бота, данные хранятся рядом со схемой):
DATABASE_URL="file:./prisma/data.db"
# PostgreSQL (если потребуется масштабирование):
# 1) в prisma/schema.prisma замените provider = "sqlite" на provider = "postgresql";
# 2) задайте строку ниже;
# 3) выполните npx prisma db push (или npx prisma migrate dev).
# DATABASE_URL="postgresql://user:password@localhost:5432/mp_arizona?schema=public"

# Уровень логирования: debug | info | warn | error (по умолчанию info)
LOG_LEVEL=info

# ── Планировщик (все необязательны, значения по умолчанию указаны ниже) ──
# Период тика планировщика, мс (минимум 5000)
SCHEDULER_TICK_MS=60000
# За сколько минут до начала МП отправляется напоминание
REMINDER_MINUTES_AHEAD=60
# Максимум напоминаний о просроченном отчёте
REPORT_REMINDER_MAX=3
# Через сколько дней завершённое МП со сданным отчётом уходит в архив
AUTO_ARCHIVE_DAYS=7
# Через сколько минут после завершения удаляется голосовой канал МП
VOICE_CLEANUP_DELAY_MINUTES=30
# Каждый N-й тик перестраивать информационные панели (планирование/активные/статистика)
BOARDS_EVERY_TICKS=15
